{
  "expo": {
    "name": "CadastroProdutos",
    "slug": "cadastro-produtos-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.cadastro.produtos",
      "versionCode": 1
    },
    "scheme": "cadastro-produtos",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-router"],
    "updates": {
      "fallbackToCacheTimeout": 0
    }
  }
}
